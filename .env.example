# Copy this file to `.env` and fill in the paths for YOUR machine.
# `.env` is git-ignored — it is never uploaded.
# คัดลอกไฟล์นี้เป็น `.env` แล้วใส่ path ของเครื่องคุณเอง (.env จะไม่ถูกอัปโหลดขึ้น git)

# Blender 4.2+ executable (used for FBX export, Smart UV bake, topology tools)
# Windows example: C:/Program Files/Blender Foundation/Blender 4.2/blender.exe
# macOS example:   /Applications/Blender.app/Contents/MacOS/Blender
BLENDER=

# Chrome / Chromium / Edge executable (used headless to export models from the browser)
# Windows example: C:/Program Files/Google/Chrome/Application/chrome.exe
# macOS example:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME=

# Python 3.10+ with numpy + Pillow (pip install -r requirements.txt)
PYTHON=python

# Port for the local dev server (npm run serve)
PORT=8129
